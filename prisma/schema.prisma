generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  EMBROIDERY
  CROCHET_APPAREL
  AMIGURUMI
  KEYCHAINS
  BAGS_ACCESSORIES
  FLOWERS_BOUQUETS
  HOME_DECOR
  CUSTOM
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  SHIPPED
  COMPLETED
  CANCELLED
}

enum CustomRequestStatus {
  NEW
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  priceCents  Int
  category    Category
  images      String // JSON-encoded array of image URLs
  stock       Int      @default(1)
  isCustom    Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id               String      @id @default(cuid())
  customerName     String
  email            String?
  phone            String
  addressLine1     String
  addressLine2     String?
  city             String
  state            String?
  postalCode       String
  country          String      @default("Pakistan")
  note             String?
  subtotalCents    Int
  deliveryFeeCents Int         @default(30000)
  status           OrderStatus @default(PENDING)
  stripeSessionId  String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameSnapshot  String
  priceCentsSnapshot Int
  quantity    Int

  @@index([orderId])
}

model CustomOrderRequest {
  id            String               @id @default(cuid())
  name          String
  email         String
  phone         String?
  description   String
  budgetCents   Int?
  referenceNote String?
  status        CustomRequestStatus  @default(NEW)
  createdAt     DateTime             @default(now())
}
