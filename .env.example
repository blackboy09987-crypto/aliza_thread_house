# --- Database ---
# Free hosted Postgres: sign up at neon.tech or supabase.com, create a
# project, and paste the connection string it gives you here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin panel login ---
# Generate a hash with: node scripts/hash-password.mjs "your-password"
# IMPORTANT: escape every "$" in the hash as "\$" or Next.js's env expansion
# will corrupt it (see the comment in scripts/hash-password.mjs).
ADMIN_PASSWORD_HASH=""
# Any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=""

# --- Stripe (optional — checkout works without it via manual EasyPaisa/JazzCash payment) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Site ---
# Set this to your real deployed URL on Vercel once you have one.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
